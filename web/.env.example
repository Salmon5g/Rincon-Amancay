# local (emuladores), real-lectura o real-api (Firebase real y API autenticada).
NUXT_PUBLIC_FIREBASE_MODO=local
NUXT_PUBLIC_FIREBASE_API_KEY=REEMPLAZAR_DESDE_FIREBASE
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TU_PROJECT_ID.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=TU_PROJECT_ID
NUXT_PUBLIC_FIREBASE_PROJECT_ID_ESPERADO=TU_PROJECT_ID
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=TU_PROJECT_ID.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
NUXT_PUBLIC_FIREBASE_APP_ID=TU_APP_ID
NUXT_PUBLIC_SUPABASE_URL=https://supabase-fixmol.codepulse.cl
# URL de la API. HTTPS para Cloud Run; http://localhost:8080 solo para API real local.
# Sin /api/v1/ al final. real-api requiere que el backend esté activo.
NUXT_PUBLIC_API_URL=
