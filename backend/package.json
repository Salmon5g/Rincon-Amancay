{
  "name": "rincon-amancay-backend-local",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/publicacion.test.ts tests/api.test.ts tests/imagenes.test.ts tests/cuentas.test.ts tests/productos.test.ts tests/stock.test.ts tests/desactivacion.test.ts tests/ciclo-cuentas.test.ts",
