rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function catalogoPublicoHabilitado() { return true; }
    function active(uid) {
      let access = get(/databases/$(database)/documents/accesos/$(uid)).data;
      return access.estado == 'activo'
        && (!('sesionesRevocadasHasta' in access) || request.auth.token.auth_time > access.sesionesRevocadasHasta);
    }
    function hasRole(uid, role) {
      return active(uid) && role in get(/databases/$(database)/documents/accesos/$(uid)).data.roles;
    }
    function admin() { return signedIn() && hasRole(request.auth.uid, 'administrador'); }
    function owner(tiendaId) {
      return signedIn() && hasRole(request.auth.uid, 'emprendedora')
        && get(/databases/$(database)/documents/accesos/$(request.auth.uid)).data.tiendaId == tiendaId
        && get(/databases/$(database)/documents/tiendasPrivadas/$(tiendaId)).data.propietarioUid == request.auth.uid;
    }
    function publicStore(tiendaId) {
      let store = get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)).data;
      return store.estadoPublicacion == 'publicado' && store.habilitada == true;
    }
    function publicAssociation(asociacionId) {
      let association = get(/databases/$(database)/documents/asociacionesPublicas/$(asociacionId)).data;
      return association.activo == true;
    }
    function publicProduct(tiendaId, productoId) {
      let product = get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)/productos/$(productoId)).data;
      return publicStore(tiendaId) && product.estadoPublicacion == 'publicado';
    }
    // La tienda decide qué proyección pública se puede leer: con precios,
    // productos; sin precios, productosConsulta, que omite todos los importes.
    function visiblePrices(tiendaId) {
      return get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)).data.mostrarPrecios == true;
    }
    function publicProductConsulta(tiendaId, productoId) {
      let product = get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)/productosConsulta/$(productoId)).data;
      return publicStore(tiendaId) && !visiblePrices(tiendaId) && product.estadoPublicacion == 'publicado';
    }
    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['avisosFerias', 'avisosConsentimientoEn'])
        && request.resource.data.avisosFerias is bool
        && request.resource.data.avisosConsentimientoEn == request.time;
      allow update: if signedIn() && request.auth.uid == uid && active(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombreMostrar', 'actualizadoEn'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nombreMostrar']) || (request.resource.data.nombreMostrar is string && request.resource.data.nombreMostrar.size() > 0 && request.resource.data.nombreMostrar.size() <= 100))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualizadoEn']) || request.resource.data.actualizadoEn == request.time);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisosFerias', 'avisosConsentimientoEn'])
        && request.resource.data.avisosFerias is bool
        && request.resource.data.avisosConsentimientoEn == request.time;
      match /dispositivosWeb/{tokenId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if signedIn() && request.auth.uid == uid && request.query.limit <= 50;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'plataforma', 'actualizadoEn'])
          && request.resource.data.token is string
          && request.resource.data.token == tokenId
          && request.resource.data.plataforma == 'web'
          && request.resource.data.actualizadoEn == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /tiendasSeguidas/{tiendaId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if signedIn() && request.auth.uid == uid && request.query.limit <= 500;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['tiendaId'])
          && request.resource.data.tiendaId == tiendaId
          && publicStore(tiendaId);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['tiendaId'])
          && request.resource.data.tiendaId == tiendaId
          && request.resource.data == resource.data
          && publicStore(tiendaId);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /asociacionesSeguidas/{asociacionId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if signedIn() && request.auth.uid == uid && request.query.limit <= 500;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['asociacionId'])
          && request.resource.data.asociacionId == asociacionId
          && publicAssociation(asociacionId);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['asociacionId'])
          && request.resource.data.asociacionId == asociacionId
          && request.resource.data == resource.data
          && publicAssociation(asociacionId);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
    match /accesos/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || admin();
      allow list: if admin();
    }
    match /invitaciones/{invitacionId} { allow read: if admin(); }
    match /reactivaciones/{operacionId} { allow read: if admin(); }
    match /desactivaciones/{operacionId} { allow read: if admin(); }
    match /emprendedoras/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid && active(uid)) || admin();
      allow list: if admin();
    }
    match /tiendasPrivadas/{tiendaId} {
      allow get: if owner(tiendaId);
      // Cambios solo en el borrador privado; publicar requiere servidor.
      allow update: if owner(tiendaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'descripcion', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 120
        && request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 2000
        && request.resource.data.actualizadoEn == request.time;
      match /configuracion/general { allow get: if owner(tiendaId); }
      match /movimientosStock/{movimientoId} { allow read: if owner(tiendaId); }
      match /ventas/{ventaId} { allow read: if owner(tiendaId); }
      match /consultas/{consultaId} {
        allow get, list: if owner(tiendaId);
        allow update: if owner(tiendaId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'leidaEn'])
          && resource.data.estado == 'nueva'
          && request.resource.data.estado == 'leida'
          && request.resource.data.leidaEn == request.time;
      }
      match /productos/{productoId} {
        allow read: if owner(tiendaId);
        // Selección del borrador: Storage se valida en el backend al publicar.
        allow update: if owner(tiendaId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imagenes', 'actualizadoEn'])
          && request.resource.data.imagenes is list
          && request.resource.data.imagenes.size() <= 5
          && request.resource.data.actualizadoEn == request.time;
        match /variantes/{varianteId} { allow read: if owner(tiendaId); }
      }
    }
    match /tiendasPublicas/{tiendaId} {
      allow get: if admin() || owner(tiendaId)
        || (catalogoPublicoHabilitado() && resource.data.estadoPublicacion == 'publicado' && resource.data.habilitada == true);
      allow list: if admin() || (catalogoPublicoHabilitado() && request.query.limit <= 20
        && resource.data.estadoPublicacion == 'publicado' && resource.data.habilitada == true);
      match /calificaciones/{compradorUid} {
        allow get: if signedIn() && request.auth.uid == compradorUid;
        allow create, update: if signedIn() && request.auth.uid == compradorUid
          && get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)).data.calificacionesHabilitadas == true
          && publicStore(tiendaId)
          && request.resource.data.keys().hasOnly(['puntuacion', 'actualizadoEn'])
          && request.resource.data.puntuacion is int && request.resource.data.puntuacion >= 1 && request.resource.data.puntuacion <= 5
          && request.resource.data.actualizadoEn == request.time;
      }
      match /productos/{productoId} {
        allow get: if admin() || owner(tiendaId)
          || (catalogoPublicoHabilitado() && resource.data.estadoPublicacion == 'publicado'
            && publicStore(tiendaId) && visiblePrices(tiendaId));
        allow list: if admin() || owner(tiendaId)
          || (catalogoPublicoHabilitado() && request.query.limit <= 20 && resource.data.estadoPublicacion == 'publicado'
            && publicStore(tiendaId) && visiblePrices(tiendaId));
        match /variantes/{varianteId} {
          allow get: if admin() || owner(tiendaId)
            || (catalogoPublicoHabilitado() && publicProduct(tiendaId, productoId) && visiblePrices(tiendaId)
              && resource.data.activa == true);
          allow list: if admin() || owner(tiendaId)
            || (catalogoPublicoHabilitado() && request.query.limit <= 100
              && publicProduct(tiendaId, productoId) && visiblePrices(tiendaId) && resource.data.activa == true);
        }
        match /calificaciones/{compradorUid} {
          allow get: if signedIn() && request.auth.uid == compradorUid;
          allow create, update: if signedIn() && request.auth.uid == compradorUid
            && get(/databases/$(database)/documents/tiendasPublicas/$(tiendaId)).data.calificacionesHabilitadas == true
            && publicProduct(tiendaId, productoId)
            && request.resource.data.keys().hasOnly(['puntuacion', 'actualizadoEn'])
            && request.resource.data.puntuacion is int && request.resource.data.puntuacion >= 1 && request.resource.data.puntuacion <= 5
            && request.resource.data.actualizadoEn == request.time;
        }
      }
      // Vista sin importes construida por la API. Firestore no puede redactar
      // campos durante una consulta, así que la colección y sus escritores son separados.
      match /productosConsulta/{productoId} {
        allow get: if admin() || owner(tiendaId)
          || (catalogoPublicoHabilitado() && resource.data.estadoPublicacion == 'publicado'
            && publicStore(tiendaId) && !visiblePrices(tiendaId));
        allow list: if admin() || owner(tiendaId)
          || (catalogoPublicoHabilitado() && request.query.limit <= 20 && resource.data.estadoPublicacion == 'publicado'
            && publicStore(tiendaId) && !visiblePrices(tiendaId));
        match /variantes/{varianteId} {
          allow get: if admin() || owner(tiendaId)
            || (catalogoPublicoHabilitado() && publicProductConsulta(tiendaId, productoId)
              && resource.data.activa == true && !resource.data.keys().hasAny(['precio']));
          allow list: if admin() || owner(tiendaId)
            || (catalogoPublicoHabilitado() && request.query.limit <= 100
              && publicProductConsulta(tiendaId, productoId) && resource.data.activa == true
              && !resource.data.keys().hasAny(['precio']));
        }
      }
    }
    match /asociacionesPublicas/{asociacionId} {
      allow get: if admin() || (catalogoPublicoHabilitado() && resource.data.activo == true);
      allow list: if admin() || (catalogoPublicoHabilitado() && request.query.limit <= 20 && resource.data.activo == true);
    }
    match /configuracionAplicacion/{configId} {
      allow get: if admin() || (catalogoPublicoHabilitado() && configId == 'navegacion');
      allow list: if admin();
    }
    match /ferias/{feriaId} {
      allow get: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora') && resource.data.estado == 'publicada')
        || (catalogoPublicoHabilitado() && resource.data.estado == 'publicada');
      allow list: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora')
          && request.query.limit <= 100 && resource.data.estado == 'publicada')
        || (catalogoPublicoHabilitado() && request.query.limit <= 100 && resource.data.estado == 'publicada');
      match /participantes/{participanteId} {
        allow read: if admin();
      }
    }
    match /sectores/{id} { allow read: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora')) || (catalogoPublicoHabilitado() && resource.data.activo == true); }
    // Un tipo o categoría inactiva deja de ofrecerse al crear productos, pero
    // una emprendedora puede leer su definición histórica para mantener fichas existentes.
    match /categorias/{id} { allow read: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora')) || (catalogoPublicoHabilitado() && resource.data.activo == true); }
    match /tiposEmprendimiento/{id} { allow read: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora')) || (catalogoPublicoHabilitado() && resource.data.activo == true); }
    match /tiposProducto/{id} {
      allow read: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora')) || (catalogoPublicoHabilitado() && resource.data.activo == true);
      match /versiones/{version} {
        allow read: if admin() || (signedIn() && hasRole(request.auth.uid, 'emprendedora'))
          || (catalogoPublicoHabilitado() && get(/databases/$(database)/documents/tiposProducto/$(id)).data.activo == true);
      }
    }
    match /operacionesAdministracion/{operationId} { allow read: if admin(); }
    match /auditoriaAdministracion/{auditId} { allow read: if admin(); }
    // Las operaciones privilegiadas de ferias, configuración, cuentas,
    // publicaciones, stock y catálogos pasan por la API; el cliente no escribe.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
