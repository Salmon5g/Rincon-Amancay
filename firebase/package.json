{
  "name": "rincon-amancay-firebase-local",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --only firestore,auth,storage --project demo-rincon-amancay --config ../firebase.json",
    "seed": "node scripts/seed.mjs",
    "seed:cloud": "node scripts/seed-cloud.mjs",
    "check": "firebase emulators:exec --only firestore,auth,storage --project demo-rincon-amancay --config ../firebase.json \"node scripts/check.mjs && node tests/permisos.mjs && node tests/storage.mjs\"",
    "test:rules": "node tests/permisos.mjs",
    "test:storage": "node tests/storage.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "15.33.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
